{
    # Replace with your admin email for ACME/TLS notifications in production.
    email admin@{$DOMAIN}
}

www.batucodes.com {
    redir https://batucodes.com{uri} permanent
}

batucodes.com {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    reverse_proxy batucodes-web:3000 {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-For {remote}
        header_up X-Real-IP {remote}
    }
}

www.{$DOMAIN} {
    redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
    encode zstd gzip

    handle_path /static/* {
        root * /srv/static
        file_server
    }

    handle_path /media/* {
        root * /srv/media
        file_server
    }

    # Backend: REST API (mounted at /api/v1/, NOT /api/ — the frontend owns
    # /api/auth/* itself as Next.js route handlers, see app/api/auth/*),
    # Django admin, Swagger/Redoc docs, health check, and the Channels
    # WebSocket endpoint (/ws/*) — reverse_proxy forwards the Upgrade/
    # Connection headers automatically, no extra directives needed.
    @backend path /api/v1/* /admin/* /healthz/* /ws/*
    handle @backend {
        reverse_proxy backend:8000 {
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
        }
    }

    # Everything else: the Next.js frontend (also carries WebSocket upgrades
    # transparently — Caddy's reverse_proxy forwards the Upgrade/Connection
    # headers automatically, no extra directives needed).
    reverse_proxy frontend:3000 {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
    }

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "same-origin"
    }
}

# ================= ubercekici.com =================
# Eklendi: UberCekici production deploy hazırlığı (/opt/UberCekici).
# UberCekici kendi Caddy'sini çalıştırmıyor; backend/websocket/frontend/
# static container'ları "edge" ağına katılıp burada isimleriyle proxy
# ediliyor (ubercekici-backend, ubercekici-websocket, ubercekici-frontend,
# ubercekici-static — bkz. /opt/UberCekici/docker-compose.yml).
# Kaynak/versiyon takibi: /opt/UberCekici/infra/caddy/ubercekici.site.caddy

www.ubercekici.com {
    redir https://ubercekici.com{uri} permanent
}

ubercekici.com {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(self), camera=(), microphone=()"
        Content-Security-Policy "default-src 'self'; img-src 'self' data: https://*.tile.openstreetmap.org https://unpkg.com; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' wss://ubercekici.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        -Server
    }

    @websocket {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    handle @websocket {
        reverse_proxy ubercekici-websocket:8001 {
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-For {remote}
            header_up X-Real-IP {remote}
        }
    }

    @static path /static/* /media/*
    handle @static {
        reverse_proxy ubercekici-static:80
    }

    handle /api/* {
        reverse_proxy ubercekici-backend:8000 {
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-For {remote}
            header_up X-Real-IP {remote}
        }
    }

    handle /django-admin/* {
        reverse_proxy ubercekici-backend:8000 {
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-For {remote}
            header_up X-Real-IP {remote}
        }
    }

    handle {
        reverse_proxy ubercekici-frontend:80 {
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-For {remote}
            header_up X-Real-IP {remote}
        }
    }

    log {
        output file /var/log/caddy/ubercekici.log {
            roll_size 10mb
            roll_keep 5
        }
        format json
    }
}

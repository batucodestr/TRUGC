# TRUGC — production environment (VPS deployment).
# Copy to `.env` on the server: `cp .env.production.example .env`
# then fill in every placeholder below before running `scripts/deploy.sh`.

# ---------------------------------------------------------------------------
# Domain — the one line to change when deploying to a new domain.
# Caddy reads this directly via {$DOMAIN} in the Caddyfile.
# ---------------------------------------------------------------------------
DOMAIN=your-domain.com

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-domain.com,backend
DJANGO_SETTINGS_MODULE=config.settings.prod

# ---------------------------------------------------------------------------
# Database (Postgres)
# ---------------------------------------------------------------------------
POSTGRES_DB=trugc
POSTGRES_USER=trugc
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://trugc:REPLACE_WITH_A_STRONG_PASSWORD@db:5432/trugc

# ---------------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# ---------------------------------------------------------------------------
# CORS / CSRF / Frontend URL
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com
FRONTEND_URL=https://your-domain.com

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# ---------------------------------------------------------------------------
# Security — production defaults (HTTPS enforced, secure cookies, HSTS)
# ---------------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
USE_X_FORWARDED_HOST=True
SECURE_PROXY_SSL_HEADER=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# ---------------------------------------------------------------------------
# Email (required for verification / password reset to actually send)
# ---------------------------------------------------------------------------
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_HOST_USER=REPLACE_ME
EMAIL_HOST_PASSWORD=REPLACE_ME
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@your-domain.com

# ---------------------------------------------------------------------------
# E-posta doğrulama (zorunlu kullanıcı akışı)
# Gmail SMTP örneği: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587,
# EMAIL_HOST_USER=<gonderen@gmail.com>, EMAIL_HOST_PASSWORD=<16 haneli uygulama
# şifresi (normal Gmail şifresi DEĞİL — 2FA açıkken "App password" üretilir)>.
# EMAIL_HOST boş bırakılırsa Django console backend'ine düşer ve doğrulama
# e-postası kullanıcıya ULAŞMAZ (yalnızca container log'una yazılır).
# ---------------------------------------------------------------------------
# Doğrulama bağlantısının geçerlilik süresi (saniye). Varsayılan 24 saat.
EMAIL_VERIFICATION_TIMEOUT_SECONDS=86400
# Zorunlu akışın adımları. Yalnızca acil durumda (ör. SMTP tamamen devre dışı)
# geçici olarak False yapılır.
ONBOARDING_REQUIRE_EMAIL_VERIFICATION=True
ONBOARDING_REQUIRE_PROFILE_PHOTO=True

# ---------------------------------------------------------------------------
# Ücretlendirme — hafta sonu ücretsiz / hafta içi ücretli
# Gün hesabı SUNUCU saatiyle ve aşağıdaki saat dilimine göre yapılır.
# BILLING_FREE_WEEKDAYS: Pazartesi=0 ... Pazar=6 → "5,6" = Cumartesi + Pazar.
# ---------------------------------------------------------------------------
BILLING_TIMEZONE=Europe/Istanbul
BILLING_FREE_WEEKDAYS=5,6
BILLING_FREE_PERIOD_ENABLED=True
BILLING_CURRENCY=TRY
# Hafta içi uygulanan platform komisyonu (yüzde). Ücretsiz dönemde 0'a düşer.
PLATFORM_COMMISSION_PERCENT=10
# Markanın creator dizinine erişim paketi. Fiyat 0 ise sanal POS ile satın alma
# akışı kapalıdır (erişim yalnızca admin panelinden manuel açılır).
BRAND_ACCESS_PRICE=0
BRAND_ACCESS_DAYS=30

# ---------------------------------------------------------------------------
# Sanal POS — kart verisi hiçbir zaman bu sunucuya girmez (sağlayıcının
# barındırdığı 3D Secure sayfasına yönlendirme modeli kullanılır).
# POS_PROVIDER boş bırakıldığı sürece ödeme başlatma ucu 503 +
# POS_NOT_CONFIGURED döner; sessizce "başarılı" davranan hiçbir varsayılan yok.
# Değerler: "" | iyzico | paytr | sandbox
# ---------------------------------------------------------------------------
POS_PROVIDER=
POS_RETURN_URL=https://your-domain.com/payment/return
POS_HTTP_TIMEOUT_SECONDS=20

# iyzico (sağlayıcıdan alınır) — canlı: https://api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# PayTR (sağlayıcıdan alınır). Canlıya geçerken PAYTR_TEST_MODE=False.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=True

# Harici çağrı yapmayan test sağlayıcısının production'da çalışmasına izin
# verir. Canlı ortamda ASLA True bırakılmamalıdır.
POS_SANDBOX_ALLOW_IN_PROD=False

# ---------------------------------------------------------------------------
# AWS S3 — flip to True once ready to move media off the VPS filesystem.
# No other code changes needed; storage backend already switches on this.
# ---------------------------------------------------------------------------
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=/api/v1
DJANGO_API_URL=http://backend:8000/api/v1
NODE_ENV=production

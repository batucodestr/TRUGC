# TRUGC — local development environment (Docker Compose).
# Copy to `.env` and adjust as needed: `cp .env.example .env`
#
# This single file is passed to every service in docker-compose.yml
# (frontend, backend, celery_worker, celery_beat) via `env_file: .env`, and
# also used by Compose itself for ${VARIABLE} interpolation (Postgres image
# env, Caddy's {$DOMAIN}).

# ---------------------------------------------------------------------------
# Domain (change this one line when deploying — Caddy reads it directly)
# ---------------------------------------------------------------------------
DOMAIN=localhost

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=dev-only-insecure-secret-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings.dev

# ---------------------------------------------------------------------------
# Database (Postgres)
# ---------------------------------------------------------------------------
POSTGRES_DB=trugc
POSTGRES_USER=trugc
POSTGRES_PASSWORD=trugc
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://trugc:trugc@db:5432/trugc

# ---------------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# ---------------------------------------------------------------------------
# CORS / CSRF / Frontend URL
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# ---------------------------------------------------------------------------
# Security (behind Caddy — leave as-is for local HTTP dev)
# ---------------------------------------------------------------------------
SECURE_SSL_REDIRECT=False
USE_X_FORWARDED_HOST=True
SECURE_PROXY_SSL_HEADER=True
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# ---------------------------------------------------------------------------
# Email (console backend in dev — nothing is actually sent)
# ---------------------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@trugc.com

# ---------------------------------------------------------------------------
# AWS S3 (future-ready, disabled by default — local dev uses the filesystem)
# ---------------------------------------------------------------------------
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
# Client-side calls go through Caddy at the same origin as the page itself,
# so this is a relative path — no CORS involved in production.
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Server-side (Next.js route handlers) talk to Django directly over the
# Docker network, bypassing Caddy.
DJANGO_API_URL=http://backend:8000/api/v1
NODE_ENV=development
